def binary_search(arr, target):
    # ...existing code...
    low, high = 0, len(arr) - 1
    found_index = -1

    while low <= high:
        mid = (low + high) // 2
        if arr[mid] == target:
            found_index = mid
            break
        elif arr[mid] < target:
            low = mid + 1
        else:
            high = mid - 1

    return found_index


numbers = list(map(int, input("Enter sorted numbers: ").split()))
target = int(input("Enter number to search: "))

result = binary_search(numbers, target)
print(result)
